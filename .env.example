# AgentOps AI Platform - Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local.

# ----------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ----------------------------------------------------------------------------
# Model overrides (optional — defaults to gemini-2.0-flash)
# ----------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.0-flash
GEMINI_RESEARCH_MODEL=gemini-2.0-flash
GEMINI_EXECUTION_MODEL=gemini-2.0-flash
GEMINI_EVALUATOR_MODEL=gemini-2.0-flash

# ----------------------------------------------------------------------------
# App behavior
# ----------------------------------------------------------------------------
# Set to 1 to skip live LLM calls (useful for local/CI testing)
OFFLINE_MODE=0

# Browser-facing backend URL used by the Docker-built frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to 1 to emit LangSmith + Langfuse traces
OBSERVABILITY_ENABLED=0

# ----------------------------------------------------------------------------
# LangSmith (optional)
# ----------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=agentops-ai-platform
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=agentops-ai-platform

# ----------------------------------------------------------------------------
# Langfuse (optional)
# ----------------------------------------------------------------------------
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
